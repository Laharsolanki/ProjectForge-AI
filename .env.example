# ProjectForge AI — Environment Variables Example
# Copy this file to .env and fill in your actual values

# Required: Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token (for automatic repository and issue generation)
# Scopes needed: repo, project, issues
GITHUB_TOKEN=

# Optional: Model Overrides (defaults to gemini-2.5-flash)
ORCHESTRATOR_MODEL=gemini-2.5-flash
WORKER_MODEL=gemini-2.5-flash

# Optional: Web Server Configuration
WEB_HOST=127.0.0.1
WEB_PORT=8000
