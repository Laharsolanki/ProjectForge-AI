# ═══════════════════════════════════════════════════════════════
# ProjectForge AI — .gitignore
# ═══════════════════════════════════════════════════════════════

# ─── Secrets & Environment ────────────────────────────────────
.env
.env.local
.env.production
PROJECT_CONTEXT.md
*.key
*.pem

# ─── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# ─── Virtual Environment ─────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Testing ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── IDE ──────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# ─── OS Files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# ─── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Local Databases & Scratch Files ─────────────────────────
memory/sessions.db
memory/*.db
test_sessions.db
*.db
test.py

# ─── Generated Reports & Logs ─────────────────────────────────
reports/
*.log
logs/

# ─── Misc & AI Workspace Histories ───────────────────────────
*.bak
*.tmp
*.temp
.cache/
.codex-history/
.claude-code-history/